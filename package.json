  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
