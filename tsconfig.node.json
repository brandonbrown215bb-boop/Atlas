{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "exclude": ["src/renderer/gen/**/*.test.ts"],
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "playwright.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/model/schema.ts",
    "src/renderer/model/themes.ts",
    "src/renderer/model/commands.ts",
    "src/renderer/model/transfer.ts",
    "src/renderer/model/sync.ts",
    "src/renderer/gen/**/*.ts",
    "src/renderer/geom/fog.ts",
    "src/renderer/geom/geography.ts",
    "src/renderer/geom/polygonClipping.ts",
    "src/renderer/geom/groupTransform.ts",
    "src/renderer/geom/pointEdit.ts",
    "src/renderer/model/mapDefaults.ts",
    "src/renderer/geom/clipOutside.ts",
    "src/renderer/geom/hitTest.ts",
    "src/renderer/geom/simplify.ts",
    "src/renderer/geom/places.ts",
    "src/renderer/geom/clipInherit.ts",
    "src/renderer/geom/expandMap.ts",
    "src/renderer/geom/pullFromParent.ts",
    "src/renderer/geom/transform.ts",
    "src/renderer/geom/measure.ts",
    "src/renderer/geom/visibility.ts",
    "src/renderer/model/assetTags.ts",
    "src/renderer/model/packs.ts",
    "src/renderer/model/migrate.ts",
    "e2e/**/*"
  ]
}
